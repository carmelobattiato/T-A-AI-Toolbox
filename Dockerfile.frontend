# ==========================================
# STAGE 1: Build React SPA with Vite
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy application sources
COPY index.html tsconfig.json vite.config.ts metadata.json ./
COPY src/ ./src/

# Build static bundle for production
RUN npm run build

# ==========================================
# STAGE 2: Serve via Nginx (unprivileged: non-root, port 8080, pid/temp in /tmp)
# ==========================================
FROM nginxinc/nginx-unprivileged:alpine

# Copy custom Nginx configuration with reverse proxy for /api/
# (explicit mode: COPY keeps the checkout's permissions, nginx runs non-root)
COPY --chmod=644 docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
