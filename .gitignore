node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Manifest Kubernetes generato da k8s/manifests.template.yaml (valori dell'ambiente)
k8s/manifests.yaml

# Note locali, specifiche dell'ambiente
*.local.md

# Dati runtime (db.json, log.json, settings.json con chiavi API, e i relativi
# .tmp / .corrupt-*): nessun .json in data/ va versionato. Alla prima esecuzione
# il backend li genera di default; data/.gitkeep mantiene la cartella.
data/*.json
data/*.json.*

# Copie di backup (contengono i dati e le chiavi delle impostazioni)
backups/
