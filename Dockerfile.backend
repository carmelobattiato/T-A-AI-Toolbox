# ==========================================
# Backend + Database Container (Node.js/Express)
# ==========================================
FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install production dependencies and tsx for execution
RUN npm ci

# Copy server code and required shared type modules
COPY tsconfig.json ./
COPY server/ ./server/
COPY src/types/ ./src/types/
COPY src/utils/ ./src/utils/

# Initial data seed directory (will be mapped to a persistent volume)
RUN mkdir -p /app/data
COPY data/ /app/data/

# COPY keeps the checkout's permissions: a restrictive umask would leave sources
# unreadable for the non-root runtime user (uid 1000 on K8s)
RUN chmod -R a+rX /app/package.json /app/package-lock.json /app/tsconfig.json /app/server /app/src /app/data

# Environment configurations
ENV PORT=5000
ENV NODE_ENV=production
ENV DATA_DIR=/app/data

# Persistent volume for JSON/sqlite database file
VOLUME ["/app/data"]

EXPOSE 5000

# Start standalone backend server (tsx binary directly: npx needs a writable ~/.npm,
# which is not available with readOnlyRootFilesystem on K8s)
CMD ["node_modules/.bin/tsx", "server/standalone.ts"]
